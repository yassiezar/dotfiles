  "agents": {
    "gatekeeper": {
      "model": "openai/gpt-5.6-terra",
      "variant": "high",
      "skills": [],
      "mcps": [],
      "prompt": "Read agents/gatekeeper.md first and follow it exactly. Review only explicitly supplied files or diffs before a remote Pull Request exists. Do not inspect local Git state or run Git; state unavailable repository context as a scope limitation. Remain read-only: never use GitHub, edit files, or delegate tasks.",
      "permission": {
        "read": "allow",
        "bash": "deny",
        "edit": "deny",
        "task": "deny"
      },
      "orchestratorPrompt": "@gatekeeper Route reviews of explicitly supplied local files or diffs here, including final supplied-material review before reporting implementation success. This agent owns supplied material only and has no local Git inspection capability. Route remote GitHub Pull Request review, a Pull Request URL or number, and requested inspection of GitHub Pull Request changes or metadata to @pr-reviewer. Exclude security-only audits and routine implementation. Normal agents have no Bash access; only PR agents may perform constrained read-only GitHub inspection. All agents must never post, reply, approve, request changes, merge, label, close, reopen, or otherwise mutate GitHub; return draft text only. PR reviewers remain read-only."
    },
    "pr-reviewer": {
      "model": "openai/gpt-5.6-terra",
      "variant": "high",
      "skills": [],
      "mcps": [],
