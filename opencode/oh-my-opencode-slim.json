          "gh api * --method=PATCH*": "deny",
          "gh api * --method=DELETE*": "deny",
          "gh api * -X POST *": "deny",
          "gh api * -X PUT *": "deny",
          "gh api * -X PATCH *": "deny",
          "gh api * -X DELETE *": "deny",
          "gh api * -XPOST*": "deny",
          "gh api * -XPUT*": "deny",
