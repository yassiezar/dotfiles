          "gh api graphql * --raw-field *": "deny",
          "gh api graphql * -f * -f *": "deny",
          "gh api graphql *mutation*": "deny",
          "gh api graphql *Mutation*": "deny",
          "gh api graphql *MUTATION*": "deny"
        },
        "edit": "deny",
        "task": "deny"
