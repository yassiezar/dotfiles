{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "~/.config/opencode/plugins/caveman/plugin.js",
    "@slkiser/opencode-quota@latest",
    "oh-my-opencode-slim"
  ],
  "model": "openai/gpt-5.6-terra",
  "agent": {
    "build": {
      "mode": "primary",
      "model": "openai/gpt-5.6-terra",
      "permission": {
        "bash": "deny"
      }
    },
    "explore": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna-fast",
      "disable": true,
      "permission": {
        "bash": "deny"
      }
    },
    "plan": {
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "permission": {
        "bash": "deny"
      }
    },
    "general": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-sol",
      "disable": true,
      "permission": {
        "bash": "deny"
      }
    },
    "scout": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "permission": {
        "bash": "deny"
      }
    },
    "compaction": {
      "mode": "primary",
      "model": "openai/gpt-5.6-luna",
      "permission": {
        "bash": "deny"
      }
    },
    "title": {
      "mode": "primary",
      "model": "openai/gpt-5.6-luna-fast",
      "permission": {
        "bash": "deny"
      }
    },
    "summary": {
      "mode": "primary",
      "model": "openai/gpt-5.6-luna-fast",
      "permission": {
        "bash": "deny"
      }
    }
  },
  "autoshare": false,
  "permission": {
    "bash": "deny"
  },
  "lsp": {
    "python": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py"
      ]
    },
    "typescript": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ]
    },
    "rust": {
      "command": [
        "rust-analyzer",
        "--stdio"
      ],
      "extensions": [
        ".rs"
      ]
    }
  },
  "formatter": {
    "python": {
      "command": [
        "ruff",
        "format"
      ],
      "extensions": [
        ".py"
      ]
    },
    "javascript": {
      "command": [
        "prettier",
        "--write"
      ],
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx"
      ]
    },
    "json": {
      "command": [
        "prettier",
        "--write"
      ],
      "extensions": [
        ".json",
        ".jsonc"
      ]
    },
    "go": {
      "command": [
        "gofmt"
      ],
      "extensions": [
        ".go"
      ]
    },
    "rust": {
      "command": [
        "rustfmt"
      ],
      "extensions": [
        ".rs"
      ]
    }
  }
}
