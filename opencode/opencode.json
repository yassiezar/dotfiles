{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "~/.config/opencode/plugins/caveman/plugin.js",
    "@slkiser/opencode-quota@latest",
    "oh-my-opencode-slim"
  ],
  "model": "openai/gpt-6.1-terra",
  "agent": {
    "compaction": {
      "mode": "primary",
      "model": "openai/gpt-6-luna",
      "permission": {
        "bash": "deny"
      }
    },
    "title": {
      "mode": "primary",
      "model": "openai/gpt-6-luna",
      "permission": {
        "bash": "deny"
      }
    },
    "summary": {
      "mode": "primary",
      "model": "openai/gpt-6-luna",
      "permission": {
        "bash": "deny"
      }
    }
  },
  "autoshare": false,
  "permission": {
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "which *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "rg": "allow",
      "rg *": "allow",
      "grep": "allow",
      "grep *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow"
    }
  },
  "lsp": {
    "python": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py"
      ]
    },
    "typescript": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ]
    },
    "rust": {
      "command": [
        "rust-analyzer",
        "--stdio"
      ],
      "extensions": [
        ".rs"
      ]
    }
  },
  "formatter": {
    "python": {
      "command": [
        "ruff",
        "format"
      ],
      "extensions": [
        ".py"
      ]
    },
    "javascript": {
      "command": [
        "prettier",
        "--write"
      ],
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx"
      ]
    },
    "json": {
      "command": [
        "prettier",
        "--write"
      ],
      "extensions": [
        ".json",
        ".jsonc"
      ]
    },
    "go": {
      "command": [
        "gofmt"
      ],
      "extensions": [
        ".go"
      ]
    },
    "rust": {
      "command": [
        "rustfmt"
      ],
      "extensions": [
        ".rs"
      ]
    }
  },
  "provider": {
    "openai": {}
  },
  "mcp": {
    "firefox-devtools": {
      "type": "local",
      "command": [
        "npx", "-y", "@mozilla/firefox-devtools-mcp@v0.10.7",
        "--connect-existing", "--marionette-port", "2828",
        "--tool-preset", "developer"
      ],
      "enabled": true
    }
  }
}
