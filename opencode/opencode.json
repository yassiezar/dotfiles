  "autoshare": false,
  "permission": {
    "bash": {
      "*": "allow",
      "gh": "deny",
      "gh *": "deny",
      "hub": "deny",
      "hub *": "deny",
      "git push": "deny",
      "git push *": "deny",
      "git -C * push": "deny",
      "git -C * push *": "deny",
      "curl *github.com*": "deny",
      "curl *api.github.com*": "deny",
      "wget *github.com*": "deny",
      "wget *api.github.com*": "deny",
      "http *github.com*": "deny",
      "http *api.github.com*": "deny"
    }
  },
  "lsp": {
    "python": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py"
      ]
    },
    "typescript": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ]
    },
    "rust": {
      "command": [
        "rust-analyzer",
        "--stdio"
      ],
      "extensions": [
        ".rs"
      ]
    }
  },
  "formatter": {
    "python": {
      "command": [
        "ruff",
        "format"
      ],
      "extensions": [
        ".py"
      ]
    },
    "javascript": {
      "command": [
        "prettier",
        "--write"
      ],
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx"
      ]
    },
    "json": {
      "command": [
        "prettier",
        "--write"
      ],
      "extensions": [
        ".json",
        ".jsonc"
      ]
    },
    "go": {
      "command": [
        "gofmt"
      ],
      "extensions": [
        ".go"
      ]
    },
    "rust": {
      "command": [
        "rustfmt"
      ],
      "extensions": [
        ".rs"
      ]
    }
  }
}
