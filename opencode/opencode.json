{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "~/.config/opencode/plugins/caveman/plugin.js",
    "oh-my-opencode-slim",
    "@slkiser/opencode-quota@latest"
  ],
  "model": "openai/gpt-5.6-terra",
  "agent": {
    "build": {
      "mode": "primary",
      "model": "openai/gpt-5.6-terra",
      "permission": {
        "bash": {
          "*": "allow",
          "gh": "deny",
          "gh *": "deny",
          "hub": "deny",
          "hub *": "deny",
          "git push": "deny",
          "git push *": "deny",
          "git -C * push": "deny",
          "git -C * push *": "deny",
          "curl *github.com*": "deny",
          "curl *api.github.com*": "deny",
          "wget *github.com*": "deny",
          "wget *api.github.com*": "deny",
          "http *github.com*": "deny",
          "http *api.github.com*": "deny"
        }
      }
    },
